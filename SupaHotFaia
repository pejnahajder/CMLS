(
var scAddr = NetAddr("127.0.0.1", NetAddr.langPort);
s.waitForBoot({
    SynthDef(\navPing, {
        arg out=0, freq=880, bpm=60, pan=0, reverb=0.8, amp=0.3;
        var beatRate = bpm/60;
        var gate = LFPulse.kr(beatRate, width:0.5);
        var env = Lag.kr(gate, 0.01);
        var sig = SinOsc.ar(freq)*env*amp;
        var dry = Pan2.ar(sig, pan);
        var wet = FreeVerb2.ar(dry[0], dry[1], mix:reverb, room:0.8, damp:0.5);
        Out.ar(out, wet);
    }).add;
    SynthDef(\alarmSynth, {
        arg out=0, gate=0, amp=0.4;
        var env = EnvGen.kr(Env.asr(0.1, 1, 0.2), gate);
        var sig = Saw.ar([300, 314])*LFPulse.kr(20).range(0.2, 1.0);
        Out.ar(out, sig*env*amp);
    }).add;
    s.sync;
    ~ping = Synth(\navPing);
    ~alarm = Synth(\alarmSynth);
    ~cfgMinBpm = 60;
    ~cfgMaxBpm = 600;
    ~cfgBpmCurve = 4;
    ~cfgMinPitch = 200;
    ~cfgMaxPitch = 1200;
    ~cfgAlarmThreshold = 0.03;
    ~valLeft = 0.0;
    ~valCenter = 0.0;
    ~valRight = 0.0;
    ~valPitch = 0.0;
    ~valDepth = 1.0;
    ~lastDepth = 1.0;
    ~updateAudio = {
        var outPan, outBpm, outReverb, outPitch, maxPericolo, deltaProfondita;
        outPan = (~valRight - ~valLeft).clip(-1.0, 1.0);
        maxPericolo = max(~valLeft, max(~valCenter, ~valRight));
        outBpm = maxPericolo.lincurve(0.0, 1.0, ~cfgMinBpm, ~cfgMaxBpm, ~cfgBpmCurve);
        outReverb = ~valCenter.linlin(0.0, 1.0, 0.8, 0.0);
        outPitch = ~valPitch.linlin(-90, 90, ~cfgMinPitch, ~cfgMaxPitch);
        deltaProfondita = ~lastDepth - ~valDepth;
        if(deltaProfondita > ~cfgAlarmThreshold) {
            ~alarm.set(\gate, 1);
        } {
            ~alarm.set(\gate, 0);
        };
        ~lastDepth = ~valDepth;
        ~ping.set(\pan, outPan, \bpm, outBpm, \reverb, outReverb, \freq, outPitch);
    };
    OSCdef(\guiMinBpm, { |msg| ~cfgMinBpm = msg[1].asFloat; }, "/gui/minBpm");
    OSCdef(\guiMaxBpm, { |msg| ~cfgMaxBpm = msg[1].asFloat; }, "/gui/maxBpm");
    OSCdef(\guiBpmCurve, { |msg| ~cfgBpmCurve = msg[1].asFloat; }, "/gui/bpmCurve");
    OSCdef(\guiMinPitch, { |msg| ~cfgMinPitch = msg[1].asFloat; }, "/gui/minPitch");
    OSCdef(\guiMaxPitch, { |msg| ~cfgMaxPitch = msg[1].asFloat; }, "/gui/maxPitch");
    OSCdef(\guiAlarmThresh, { |msg| ~cfgAlarmThreshold = msg[1].asFloat; }, "/gui/alarmThresh");
    OSCdef(\sensLeft, { |msg| ~valLeft = msg[1].asFloat; ~updateAudio.value; }, "/sensor/left");
    OSCdef(\sensCenter, { |msg| ~valCenter = msg[1].asFloat; ~updateAudio.value; }, "/sensor/center");
    OSCdef(\sensRight, { |msg| ~valRight = msg[1].asFloat; ~updateAudio.value; }, "/sensor/right");
    OSCdef(\sensPitch, { |msg| ~valPitch = msg[1].asFloat; ~updateAudio.value; }, "/sensor/pitch");
    OSCdef(\sensDepth, { |msg| ~valDepth = msg[1].asFloat; ~updateAudio.value; }, "/sensor/depth");
    "init ok".postln;
});
)
