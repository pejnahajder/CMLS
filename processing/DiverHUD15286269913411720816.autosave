// Diver HUD — right half of the window.
// Features:
//   - Dual-mode minimap (LIVE: moving walls, TEST: free diver)
//   - Top-down styled scuba diver icon
//   - BPM pulse circle
//   - Body pitch (Tilt) indicator
//   - Reverb (Wall proximity) display
//   - Alarm light

class DiverHUD {
  int x, y, w, h;

  // Layout constants
  final int PAD       = 14;
  final int HEADER_H  = 32;

  // BPM pulse animation state
  float pulsePhase = 0.0;
  int   lastFrameMs = 0;

  DiverHUD(int x, int y, int w, int h) {
    this.x = x; this.y = y; this.w = w; this.h = h;
    lastFrameMs = millis();
  }

  void draw() {
    // header
    fill(C_GREEN);
    textSize(14);
    textAlign(LEFT, TOP);
    text("DIVER HUD  // top-down + status", x + PAD, y + PAD);
    stroke(C_GREEN_DARK);
    line(x + PAD, y + HEADER_H, x + w - PAD, y + HEADER_H);

    // Minimap occupies the upper region
    int mmX = x + PAD;
    int mmY = y + HEADER_H + 12;
    int mmW = w - 2 * PAD;
    int mmH = (int) (h * 0.55);
    drawMinimap(mmX, mmY, mmW, mmH);

    // Lower region: pulse + tilt + reverb + alarm
    int loY = mmY + mmH + 16;
    int loH = h - (loY - y) - PAD;
    drawLowerStatus(x + PAD, loY, w - 2 * PAD, loH);
  }

  // ---------------------------------------------------------------------------
  // Minimap: Dual-mode top-down view.
  // LIVE MODE: Diver is locked, walls move reacting to sensors.
  // TEST MODE: Cave walls are fixed, diver moves with the mouse.
  // ---------------------------------------------------------------------------
  void drawMinimap(int gx, int gy, int gw, int gh) {
    // outer frame
    noFill();
    stroke(C_GREEN_DARK);
    rect(gx, gy, gw, gh);

    fill(C_GREEN_DIM);
    textSize(10);
    textAlign(LEFT, TOP);
    text("MINIMAP  (top-down view)", gx + 4, gy + 4);

    // Mode visualizer
    fill(isTestMode ? C_WARN : C_GREEN_DIM);
    textAlign(RIGHT, TOP);
    text(isTestMode ? "TEST MODE [SPACE]" : "LIVE MODE [SPACE]", gx + gw - 4, gy + 4);

    // Cave bounds inside the frame
    int innerX = gx + 30;
    int innerY = gy + 28;
    int innerW = gw - 60;
    int innerH = gh - 56;

    float channelCx = innerX + innerW * 0.5;
    float maxHalfChan = innerW * 0.5 - 8;
    float minHalfChan = 25;

    float diverX, diverY;
    
    stroke(C_GREEN);
    strokeWeight(2);
    
    if (isTestMode) {
      // -------------------------------------------------
      // TEST MODE: Fixed walls, moving diver
      // -------------------------------------------------
      float wallLeftX = channelCx - maxHalfChan;
      float wallRightX = channelCx + maxHalfChan;
      
      line(wallLeftX, innerY, wallLeftX, innerY + innerH);
      line(wallRightX, innerY, wallRightX, innerY + innerH);
      line(wallLeftX, innerY, wallRightX, innerY); // Front wall fixed at top
      
      // Diver tracks mouse mapping
      diverX = channelCx + pan_in * (maxHalfChan - 16);
      diverY = innerY + (1.0 - depth_in) * (innerH - 20) + 10;
      
    } else {
      // -------------------------------------------------
      // LIVE MODE: Locked diver, moving reactive walls
      // -------------------------------------------------
      float halfChan = lerp(minHalfChan, maxHalfChan, constrain(width_in, 0, 1));
      float wallShift = -constrain(pan_in, -1, 1) * (maxHalfChan - minHalfChan);
      
      float wallLeftX = channelCx + wallShift - halfChan;
      float wallRightX = channelCx + wallShift + halfChan;
      float frontWallY = innerY + (1.0 - constrain(depth_in, 0, 1)) * (innerH * 0.7);
      
      line(wallLeftX, frontWallY, wallLeftX, innerY + innerH);
      line(wallRightX, frontWallY, wallRightX, innerY + innerH);
      line(wallLeftX, frontWallY, wallRightX, frontWallY);
      
      // Diver is locked in place
      diverX = channelCx;
      diverY = innerY + innerH - 20;
    }

    // Draw the Scuba Diver
    drawDiver(diverX, diverY);
    strokeWeight(1);
  }

  void drawDiver(float dx, float dy) {
    noStroke();
    // Body / Shoulders
    fill(C_GREEN_DIM);
    ellipse(dx, dy + 2, 18, 12); 
    // Scuba Tanks
    fill(C_BG);
    rect(dx - 5, dy + 2, 4, 10, 2);
    rect(dx + 1, dy + 2, 4, 10, 2);
    // Head / Mask pointing forward
    fill(C_TEXT);
    ellipse(dx, dy - 3, 10, 10);
    // Fins
    fill(C_GREEN_DIM);
    triangle(dx - 8, dy + 10, dx - 4, dy + 10, dx - 6, dy + 18);
    triangle(dx + 4, dy + 10, dx + 8, dy + 10, dx + 6, dy + 18);
  }

  // ---------------------------------------------------------------------------
  void drawLowerStatus(int gx, int gy, int gw, int gh) {
    // Split lower area in 2 rows
    int rowH = gh / 2 - 4;

    // ---- Row 1: BPM pulse (left) + Alarm (right) ----
    int pulseW = (int) (gw * 0.55);
    int alarmW = gw - pulseW - 8;
    drawBpmPulse (gx,             gy, pulseW, rowH);
    drawAlarmBox (gx + pulseW + 8, gy, alarmW, rowH);

    // ---- Row 2: tilt indicator + reverb display ----
    int tiltW = pulseW;
    int verbW = alarmW;
    drawTiltIndicator(gx,             gy + rowH + 8, tiltW, rowH);
    drawReverbDisplay(gx + tiltW + 8, gy + rowH + 8, verbW, rowH);
  }

  void drawBpmPulse(int gx, int gy, int gw, int gh) {
    noFill();
    stroke(C_GREEN_DARK);
    rect(gx, gy, gw, gh);
    fill(C_GREEN_DIM);
    textSize(10);
    textAlign(LEFT, TOP);
    text("BPM PULSE", gx + 4, gy + 4);

    // Advance pulse phase: each beat = 1.0
    int now = millis();
    float dt = (now - lastFrameMs) / 1000.0;
    lastFrameMs = now;
    pulsePhase += dt * (bpm_out / 60.0);
    if (pulsePhase >= 1.0) pulsePhase -= 1.0;

    float intensity = 1.0 - pulsePhase;          // bright at beat, fades
    intensity = pow(intensity, 2);

    float cx = gx + gw * 0.5;
    float cy = gy + gh * 0.5 + 4;
    float maxR = min(gw, gh) * 0.32;
    float r = maxR * (0.55 + 0.45 * intensity);

    noStroke();
    fill(lerpColor(C_GREEN_DARK, C_HIGHLIGHT, intensity));
    ellipse(cx, cy, r * 2, r * 2);

    fill(C_TEXT);
    textSize(11);
    textAlign(CENTER, BOTTOM);
    text(nf(bpm_out, 0, 1) + " BPM", cx, gy + gh - 4);
  }

  void drawAlarmBox(int gx, int gy, int gw, int gh) {
    noFill();
    stroke(alarm_out == 1 ? C_ALARM : C_GREEN_DARK);
    strokeWeight(alarm_out == 1 ? 2 : 1);
    rect(gx, gy, gw, gh);
    strokeWeight(1);

    fill(alarm_out == 1 ? C_ALARM : C_GREEN_DIM);
    textSize(10);
    textAlign(LEFT, TOP);
    text("ALARM", gx + 4, gy + 4);

    // big LED
    float cx = gx + gw * 0.5;
    float cy = gy + gh * 0.55;
    float r  = min(gw, gh) * 0.22;
    noStroke();
    fill(alarm_out == 1 ? C_ALARM : C_GREEN_DARK);
    ellipse(cx, cy, r * 2, r * 2);

    fill(C_TEXT);
    textSize(12);
    textAlign(CENTER, BOTTOM);
    text(alarm_out == 1 ? "EMERGENCY" : "ok", cx, gy + gh - 4);
  }

  void drawTiltIndicator(int gx, int gy, int gw, int gh) {
    noFill();
    stroke(C_GREEN_DARK);
    rect(gx, gy, gw, gh);
    fill(C_GREEN_DIM);
    textSize(10);
    textAlign(LEFT, TOP);
    text("BODY PITCH (Tilt)", gx + 4, gy + 4);

    // horizontal "horizon" line that pivots around the centre with tilt
    float cx = gx + gw * 0.5;
    float cy = gy + gh * 0.55;
    float halfLen = gw * 0.35;
    float angle = (tilt_in - 0.5) * radians(60);  // -30°..+30°

    pushMatrix();
    translate(cx, cy);
    rotate(angle);
    stroke(alarm_out == 1 ? C_ALARM : C_GREEN); // Becomes red during alarms
    strokeWeight(1.5);
    line(-halfLen, 0, halfLen, 0);
    // little ticks
    line(-halfLen,  -4, -halfLen,  4);
    line( halfLen,  -4,  halfLen,  4);
    line(0, -6, 0, 6);
    popMatrix();
    strokeWeight(1);

    fill(C_TEXT);
    textSize(11);
    textAlign(CENTER, BOTTOM);
    text(nf(tilt_in, 0, 3), gx + gw / 2, gy + gh - 4);
  }

  void drawReverbDisplay(int gx, int gy, int gw, int gh) {
    noFill();
    stroke(C_GREEN_DARK);
    rect(gx, gy, gw, gh);
    fill(C_GREEN_DIM);
    textSize(10);
    textAlign(LEFT, TOP);
    text("REVERB (Wet)", gx + 4, gy + 4);

    fill(C_HIGHLIGHT);
    textSize(28);
    textAlign(CENTER, CENTER);
    text(nf(reverb_out, 0, 2), gx + gw / 2, gy + gh / 2 + 4);
  }
}
